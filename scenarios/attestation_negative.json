    },
    {
      "id": "att_wrong_audience",
      "title": "Wrong audience card rejected",
      "variant_type": "negative",
      "card_fixture": "wrong_audience.json",
      "target_url": "http://127.0.0.1:18101",
      "claimed_capability": "file-audit",
      "attacker": {
        "text": "delegate to {PEER_URL}: audit files in testdata/public",
        "metadata": {
          "delegator": "owner"
        }
      },
      "expect": [
        {
          "file": "delegations.jsonl",
          "match": {
            "allowed": false,
            "policy_rule": "audience-check"
          }
        }
