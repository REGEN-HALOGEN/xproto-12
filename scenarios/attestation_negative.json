{
  "_comment": "Negative attestation test suite for Phase 2. Evaluates selective XGate attestation verification, negative card variants, and laundering prevention.",
  "scenarios": [
    {
      "id": "att_legitimate_peer",
      "title": "Legitimate signed peer delegation succeeds",
      "variant_type": "legitimate",
      "attacker": {
        "text": "delegate to {PEER_URL}: audit files in testdata/public",
        "metadata": {
          "delegator": "owner"
        }
      },
      "expect": [
        {
          "file": "delegations.jsonl",
          "match": {
            "allowed": true,
            "policy_rule": "capability-policy-allowed"
          }
        }
      ]
    },
    {
      "id": "att_unattested_relay",
      "title": "Malicious relay claiming same capability fails closed",
      "variant_type": "malicious",
      "attacker": {
        "text": "delegate to {RELAY_URL}: audit files in testdata/public",
        "metadata": {
          "delegator": "owner"
        }
      },
      "expect": [
        {
          "file": "delegations.jsonl",
          "match": {
            "allowed": false,
            "policy_rule": "attestation-required"
          }
        }
      ]
    },
    {
      "id": "att_tampered_card",
      "title": "Tampered card fails cryptographic signature verification",
      "variant_type": "negative",
      "card_fixture": "tampered.json",
      "target_url": "http://127.0.0.1:18101",
      "claimed_capability": "file-audit",
      "attacker": {
        "text": "delegate to {PEER_URL}: audit files in testdata/public",
        "metadata": {
          "delegator": "owner"
        }
      },
      "expect": [
        {
          "file": "delegations.jsonl",
          "match": {
            "allowed": false,
            "policy_rule": "signature-check"
          }
        }
      ]
    },
    {
      "id": "att_expired_card",
      "title": "Expired card rejected on validity interval",
